# Kopie als .env anlegen und mit echten Werten füllen (.env wird NICHT committet)

# SMTP-Zugang für den Versand der Booking-Anfragen.
# Resend: Host und User sind fix, SMTP_PASS ist der API-Key (beginnt mit "re_").
# Einrichtung siehe MAIL.md
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# Absender der Formular-Mail – Domain muss bei Resend verifiziert sein.
MAIL_FROM=Liminal V <noreply@liminal-v.de>
# Empfänger – wird von Cloudflare Email Routing an das Gmail-Postfach weitergeleitet.
MAIL_TO=booking@liminal-v.de

# Port für den lokalen Flask-Dev-Server (python app.py).
# Im Container bindet Gunicorn fest auf 8080 – siehe Dockerfile.
PORT=8080

# production = Debug aus. Für lokale Entwicklung: development
FLASK_ENV=production
